{
  "name": "nominal",
  "version": "0.16.1",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "pnpm run lint --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "postinstall": "find node_modules -name '*.go' -delete 2>/dev/null || true"
  },
  "author": "Nominal inc",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^8.0.0",
    "@grafana/plugin-e2e": "^2.1.7",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.57.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.8.7",
    "@types/testing-library__jest-dom": "5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.3",
    "dotenv": "^17.2.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jsdoc": "^46.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "^1.105.1",
    "sass-loader": "^16.0.8",
    "semver": "^7.6.3",
    "style-loader": "3.3.4",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.1.10",
    "@grafana/runtime": "12.1.10",
    "@grafana/schema": "12.1.10",
    "@grafana/ui": "12.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "^7.8.2"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": "5.0.1",
      "brace-expansion@>=3.0.0 <5.0.11": "5.0.12",
      "@remix-run/router": "^1.23.2",
      "lodash": "4.18.1",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.7",
      "qs": "^6.14.1",
      "serialize-javascript": "^7.0.4",
      "immutable": "^5.1.8",
      "fast-uri": "^3.1.6",
      "flatted": ">=3.4.2",
      "form-data": ">=4.0.6",
      "protobufjs": ">=8.6.0",
      "ws": ">=8.21.0",
      "js-cookie": ">=3.0.7",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@<3.3.17": "3.3.20",
      "websocket-driver": ">=0.7.5",
      "postcss": ">=8.5.18",
      "uuid": "^11.1.1",
      "browserslist": "^4.28.7",
      "dompurify": "^3.4.17"
    }
  }

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  automerge: false,
  includePaths: [
    "go.mod",
    "go.sum",
    "package.json",
    "pnpm-lock.yaml",
    ".github/**"
  ],
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      // Allow npm releases to age before proposing regular updates
      matchDatasources: ["npm"],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "1 day"
    },
    {
      // Group all non-major frontend updates, including pnpm overrides
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "frontend dependencies (non-major)",
      groupSlug: "frontend-non-major"
    },
    {
      // Keep Grafana packages aligned and review minor and major updates
      matchManagers: ["npm"],
      matchPackageNames: ["@grafana/data", "@grafana/runtime", "@grafana/schema", "@grafana/ui"],
      groupName: "Grafana frontend packages",
      groupSlug: "grafana-frontend",
      separateMinorPatch: true,
      dependencyDashboardApproval: true
    },
    {
      // Open patches for the current package minor version automatically
      matchManagers: ["npm"],
      matchUpdateTypes: ["patch"],
      matchPackageNames: ["@grafana/data", "@grafana/runtime", "@grafana/schema", "@grafana/ui"],
      dependencyDashboardApproval: false
    },
    {
      // Prioritize nominal-api-go updates - create PRs immediately
      matchPackageNames: ["github.com/nominal-io/nominal-api-go"],
      prCreation: "immediate",
      reviewers: ["leundai"],
      labels: ["dependencies", "nominal-api-go"],
      groupName: "nominal-api-go",
      groupSlug: "nominal-api-go"
    },
    {
      // Bump the go directive on Go releases. CI builds with the version
      // in go.mod, and the plugin validator's govulncheck fails the release
      // build when that Go version has known vulnerabilities.
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump"
    },
    {
      // Group other Go dependency updates. nominal-api-protos-go and
      // conjure-go-runtime keep their own PRs.
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchPackageNames: [
        "!github.com/nominal-io/nominal-api-go",
        "!github.com/nominal-io/nominal-api-protos-go",
        "!github.com/palantir/conjure-go-runtime/v2"
      ],
      groupName: "go dependencies (non-major)",
      groupSlug: "go-non-major"
    },
    {
      // New Go releases (1.27 to 1.28) get their own PR. Go patch releases
      // stay in the group above.
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      matchUpdateTypes: ["minor", "major"],
      groupName: "go version",
      groupSlug: "go-version"
    },
    {
      // Group GitHub Actions updates
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
      separateMajorMinor: false
    },
    {
      // Require approval for frontend majors. Grafana packages stay grouped;
      // other majors open as separate PRs.
      matchManagers: ["npm"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true
    }
  ],
  schedule: ["at any time"],
  semanticCommits: "enabled",
  prHourlyLimit: 0,
  prConcurrentLimit: 0
}
